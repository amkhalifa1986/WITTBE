# Copy to /opt/witt/.env on the server and fill in. Never commit the real file.
# Use letters and digits only in passwords (no ; or quotes).

# Domains — each must have a DNS "A" record pointing to the server's IP.
# No domain yet? Use sslip.io, e.g. app.203.0.113.10.sslip.io
WEB_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

# Database
MYSQL_DATABASE=WhereIsTheTrain
MYSQL_USER=witt_user
MYSQL_PASSWORD=change_me_long_random
MYSQL_ROOT_PASSWORD=change_me_another_long_random

# Auth — at least 64 random characters (openssl rand -hex 48)
JWT_SECRET=change_me

# Email (account confirmation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
